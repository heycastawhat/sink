# Copy to .env and fill in. Everything Sink needs to run is in this file.

# Every address Sink is reached on, main one first, comma-separated (no trailing slash).
# Sign-in only ever redirects back to these.
SINK_PUBLIC_URLS=https://notes.example.com

# --- Sign-in: any OpenID Connect provider (authentik, Pocket ID, Keycloak, Authelia, Zitadel, Google, ...) ---
# Create an OAuth2/OIDC client for Sink with these redirect URIs (one per address above):
#   https://notes.example.com/api/auth/oidc/callback
# The issuer is the provider's base URL that serves /.well-known/openid-configuration.
SINK_OIDC_ISSUER=https://auth.example.com/application/o/sink/
SINK_OIDC_CLIENT_ID=
# Leave empty for a public (PKCE-only) client.
SINK_OIDC_CLIENT_SECRET=
# Who may sign in: your username, OIDC subject or verified email, comma-separated; or group names.
# Sink refuses to start with both empty, so a provider shared with other people can't let them in.
SINK_OIDC_ALLOWED_USERS=you@example.com
SINK_OIDC_ALLOWED_GROUPS=
# Only if the provider itself restricts who can use this app: let any account it signs in through.
# SINK_OIDC_ALLOW_ANY_USER=true
# Shown on the sign-in button ("Sign in with Pocket ID").
SINK_OIDC_NAME=

# Your time zone, for todo reminders and note dates.
SINK_TIMEZONE=Europe/London

# Seconds between rescans of the notes folder, to pick up edits made outside Sink (Obsidian, Syncthing, a NAS).
SINK_NOTES_SCAN_SECONDS=30

# Run as this user and group (owner of ./data and ./notes on the host).
# PUID=1000
# PGID=1000

# --- Email in (optional): forward mail to a mailbox and it becomes a note. Leave SINK_IMAP_HOST empty to turn off. ---
# you+todo@... -> line in Todo.md, anything else -> note in Inbox/.
# Only mail From these addresses (or @domains) with an aligned DKIM/SPF pass is accepted.
SINK_IMAP_HOST=
SINK_IMAP_PORT=993
SINK_IMAP_SECURE=true
SINK_IMAP_USER=
SINK_IMAP_PASSWORD=
SINK_IMAP_MAILBOX=INBOX
SINK_IMAP_PROCESSED_FOLDER=Sink/Processed
SINK_IMAP_REJECTED_FOLDER=Sink/Rejected
SINK_IMAP_ALLOWED_FROM=
# Strongly recommended: the id your mail provider stamps on Authentication-Results headers (look at the first word
# after "Authentication-Results:" on a received message, e.g. mx.google.com or mx.zoho.com). Without it Sink trusts
# the topmost such header, which a sender could forge if your mail host doesn't add its own.
SINK_IMAP_AUTHSERV_ID=

# --- Plugins ---
# Built in: diagrams (```mermaid), math (```math), daily (Today's note), webhooks (off until URLs are set).
# Turn any off by id, comma-separated. Your own plugins go in ./plugins (see docs/plugins.md).
SINK_PLUGINS_DISABLED=
# Daily notes: folder and template (Obsidian-style {{date}} {{time}} {{title}}).
# SINK_PLUGIN_DAILY_FOLDER=Daily
# SINK_PLUGIN_DAILY_TEMPLATE=Templates/Daily.md
# Webhooks: POST note and todo events to these URLs, signed with the secret (X-Sink-Signature: sha256=<hmac>).
SINK_PLUGIN_WEBHOOKS_URLS=
SINK_PLUGIN_WEBHOOKS_SECRET=
# Only these events (default all): note.created,note.updated,note.deleted,note.moved,todo.done,todo.undone
SINK_PLUGIN_WEBHOOKS_EVENTS=

# Daily database snapshots in data/backups; how many days to keep (0 = off).
SINK_BACKUP_KEEP=7
