# Every origin Sink is reached on, public first. OIDC only redirects back to these.
SINK_PUBLIC_URLS=https://sink.notahomelab.xyz,http://192.168.86.245:8787

# authentik: Applications > Providers > Sink (OAuth2/OpenID, confidential).
SINK_OIDC_ISSUER=https://auth.notahomelab.xyz/application/o/sink/
SINK_OIDC_CLIENT_ID=sink
SINK_OIDC_CLIENT_SECRET=
# Optional extra gate on top of authentik's policy bindings (username, email or sub; or group names).
SINK_OIDC_ALLOWED_USERS=josh
SINK_OIDC_ALLOWED_GROUPS=

# AI: any OpenAI-compatible endpoint.
# OpenRouter (default). Free vision models: https://openrouter.ai/models?input_modalities=image&max_price=0
SINK_AI_BASE_URL=https://openrouter.ai/api/v1
SINK_AI_API_KEY=
# Fallback chain, tried in order: free Gemma 4 first, then Qwen flash (~$0.0001/capture, needs OpenRouter credit).
SINK_AI_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,qwen/qwen3.7-flash

# Local Ollama instead:
# SINK_AI_BASE_URL=http://ollama:11434/v1
# SINK_AI_MODELS=qwen2.5vl:7b
