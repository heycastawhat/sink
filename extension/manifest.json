{
  "manifest_version": 3,
  "name": "Sink",
  "version": "0.1.0",
  "description": "Clip pages and write quick notes and todos into your own Sink server.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open Sink" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+S" }, "description": "Open Sink" },
    "clip-page": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Clip this page to Sink" }
  }
}
